# Docker image to run. Pin a sha-* tag or @sha256 digest for stricter deploys.
APP_IMAGE=ghcr.io/bookorbit/bookorbit:latest

# BookOrbit listens on port 3000 on Terra.
APP_PORT=3000

# Existing Calibre library mounted in the container as /books for migration.
BOOKS_HOST_PATH=/mnt/calibre-library
LIBRARY_BROWSE_ROOT=/books

# Container runtime UID/GID for files written to app-managed data folders.
PUID=1000
PGID=1000

# Database credentials
POSTGRES_USER=bookorbit
POSTGRES_PASSWORD=CHANGE_THIS_POSTGRES_PASSWORD
POSTGRES_DB=bookorbit

# App secrets. Replace JWT_SECRET before using BookOrbit.
JWT_SECRET=CHANGE_THIS_JWT_SECRET
# This value is replaced with a random 32-hex token when .env is first created.
SETUP_BOOTSTRAP_TOKEN=CHANGE_THIS_SETUP_BOOTSTRAP_TOKEN

# External URL for emails and Kobo endpoints.
APP_URL=http://CHANGE_THIS_BOOKORBIT_HOST:3000

# Node.js JavaScript heap limit in MB.
NODE_MAX_OLD_SPACE_SIZE=2048

# Necesse Server Configuration
# Copy this file to .env and customize the values

# Server authentication
SERVER_PASSWORD=changeme
OWNER_USERNAME=YourUsername

# Server settings (uncomment to customize)
# WORLD=world
# SLOTS=10
# PAUSE=0
# LOGGING=1
# ZIP=1

# JVM settings (uncomment to adjust memory allocation)
# JVMARGS=-Xmx2G

# Message of the Day (uncomment to set)
# MOTD=Welcome to the Necesse Server!
